@page "/api/mutation"

<PageTitle>Mutation&lt;T&gt; — Deja API</PageTitle>

<h1>Mutation&lt;T&gt;</h1>
<p class="lead">
    Tracks a single asynchronous write and exposes its lifecycle as bindable state, notifying its
    attached listener as it advances so the owning component can re-render.
</p>

<CodeBlock Code="public class Mutation<T> : DejaObservable"/>

<h2>Constructors</h2>

<ApiMember Id="ctor" Name="Mutation()" Signature="public Mutation()">
    <p>Creates a mutation that resolves its cache client from the owning component (if any).</p>
</ApiMember>

<ApiMember Id="ctor-client" Name="Mutation(DejaClient)" Signature="public Mutation(DejaClient client)">
    <p>Creates a mutation bound to <code>client</code>, for use outside a component. Throws
        <code>ArgumentNullException</code> when <code>client</code> is null.</p>
</ApiMember>

<h2>State</h2>

<ApiTable Rows="@_state"/>

<h2>Methods</h2>

<ApiMember Id="execute-simple" Name="Execute (shorthand)"
           Signature="public Task Execute(Func<Task<T>> mutationFunction, Action<MutationParameters<T>>? configure = null)">
    <p>Runs a mutation — the shorthand for the common case, with anything else (typically
        <code>InvalidateKeys</code>) set by the configure hook. Throws
        <code>ArgumentNullException</code> when <code>mutationFunction</code> is null.</p>
</ApiMember>

<ApiMember Id="execute-cancellable" Name="Execute (cancellation-aware shorthand)"
           Signature="public Task Execute(Func<CancellationToken, Task<T>> mutationFunction, Action<MutationParameters<T>>? configure = null)">
    <p>Runs a cancellation-aware mutation. The token is the owning component's lifetime token, so
        an in-flight write is abandoned when the component is disposed:</p>
    <CodeBlock Code="@("_addTodo.Execute(token => Api.AddTodoAsync(title, token));")"/>
</ApiMember>

<ApiMember Id="execute-full" Name="Execute (full form)"
           Signature="public Task Execute(MutationParameters<T> parameters)">
    <p>Runs the mutation described by <code>parameters</code>. If the effective token is already
        cancelled (the component is gone), returns without starting the write. On success, runs the
        success callbacks and then invalidates <code>InvalidateKeys</code> — after
        <code>OnSuccess</code>, so a callback observing the result runs before dependent queries
        start refetching.</p>
</ApiMember>

<h2>Failure contract</h2>
<p>
    On failure, <code>Data</code> resets to default, the error state is published and the error
    callbacks run. An <code>InvalidOperationException</code> wrapping the original exception is
    thrown <strong>only when no error callback was supplied</strong> — wire
    <code>OnError</code> (or any other error callback) and the failure stays handled instead of
    escaping into the component lifecycle. Cancellation is not a failure: no error state, no
    callbacks (settled included).
</p>

@code {
    private static readonly ApiRow[] _state =
    [
        new("IsLoading", "bool", null, "True while the mutation is running."),
        new("IsError", "bool", null, "True when the most recent execution failed."),
        new("ErrorMessage", "string?", null, "The failure message of the most recent execution, when <code>IsError</code> is true."),
        new("Data", "T?", null, "The result of the most recent successful execution. Void mutation shapes leave it untouched; a failure resets it to default."),
    ];
}
