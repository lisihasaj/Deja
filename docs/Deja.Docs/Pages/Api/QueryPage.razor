        new("IsError", "bool", null, "True when the most recent execution failed. Cleared by a successful refetch."),
        new("ErrorMessage", "string?", null, "The failure message of the most recent execution, when <code>IsError</code> is true."),
        new("Data", "T?", null, "The most recently fetched data."),
        new("ReFetchCount", "int", null, "How many times the query has been executed."),
        new("IsReFetching", "bool", null, "True while an execution after the first is loading. Use for subtle refresh indicators."),
        new("UpdatedAt", "DateTimeOffset?", null, "When the current <code>Data</code> was fetched (cached path only); null on the uncached path or before the first result."),
        new("IsCachedData", "bool", null, "True while <code>Data</code> was served from the cache and no fresh fetch has completed during this query's subscription."),
        new("IsStale", "bool", null, "True when the observed cache entry is invalidated or older than the effective stale time (cached path only; always false uncached)."),
    ];
}
