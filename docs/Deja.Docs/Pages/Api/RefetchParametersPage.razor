<CodeBlock Code="@Sample"/>

@code {
    private ApiRow[] Rows => De
        ?
        [
            new("CancellationToken", "CancellationToken?", null, "Ersetzt den Token für diesen Refetch."),
            new("OnSuccessAsync / OnSuccess", "Func<T?, Task>? / Action<T?>?", null, "Ersetzen die Erfolgs-Callbacks für diesen Refetch."),
            new("OnErrorAsync / OnError", "Func<Exception, Task>? / Action<Exception>?", null, "Ersetzen die Fehler-Callbacks für diesen Refetch."),
            new("OnDisplayUserErrorAsync / OnDisplayUserError", "Func<DisplayUserException, Task>? / Action<DisplayUserException>?", null, "Ersetzen die Display-User-Error-Callbacks für diesen Refetch."),
            new("OnSettledAsync / OnSettled", "Func<T?, Task>? / Action<T?>?", null, "Ersetzen die Settled-Callbacks für diesen Refetch."),
            new("StaleTime", "TimeSpan?", null, "Ersetzt die Stale-Time für diesen Refetch. Der Refetch selbst fetcht immer; das ändert nur, wie bald das frische Ergebnis wieder als stale gilt."),
            new("CacheTime", "TimeSpan?", null, "Ersetzt die Cache-Zeit für diesen Refetch."),
        ]
        :
        [
            new("CancellationToken", "CancellationToken?", null, "Replaces the token for this refetch."),
            new("OnSuccessAsync / OnSuccess", "Func<T?, Task>? / Action<T?>?", null, "Replace the success callbacks for this refetch."),
            new("OnErrorAsync / OnError", "Func<Exception, Task>? / Action<Exception>?", null, "Replace the error callbacks for this refetch."),
            new("OnDisplayUserErrorAsync / OnDisplayUserError", "Func<DisplayUserException, Task>? / Action<DisplayUserException>?", null, "Replace the display-user error callbacks for this refetch."),
            new("OnSettledAsync / OnSettled", "Func<T?, Task>? / Action<T?>?", null, "Replace the settled callbacks for this refetch."),
            new("StaleTime", "TimeSpan?", null, "Replaces the stale time for this refetch. The refetch itself always fetches; this only changes how soon the fresh result counts as stale again."),
            new("CacheTime", "TimeSpan?", null, "Replaces the cache time for this refetch."),
        ];

    private const string Sample = """
await _todos.Refetch(new RefetchParameters<List<Todo>>
{
    StaleTime = TimeSpan.FromMinutes(1),
    OnSettled = _ => _lastRefreshed = DateTimeOffset.Now,
});
""";
}
