@code {
    private ApiRow[] Rows => De
        ?
        [
            new("IfStale", "default", null, "Lädt nur dann im Hintergrund neu, wenn die Daten älter als die Stale-Time sind."),
            new("Always", "", null, "Lädt immer im Hintergrund neu, auch solange die Daten frisch sind."),
            new("Never", "", null, "Liefert den Cache und lädt beim Mount nie neu. Invalidierung lädt weiterhin neu."),
        ]
        :
        [
            new("IfStale", "default", null, "Refetch in the background only when the data is older than the stale time."),
            new("Always", "", null, "Always refetch in the background, even while fresh."),
            new("Never", "", null, "Serve the cache and never refetch on mount. Invalidation still refetches."),
        ];

    private const string RefetchSample = """
<button @onclick="() => _todos.Refetch()">Refresh</button>

// with one-shot overrides:
await _todos.Refetch(new RefetchParameters<List<Todo>>
{
    StaleTime = TimeSpan.FromSeconds(30),   // how soon the fresh result goes stale again
    OnSettled = _ => _lastRefreshed = DateTimeOffset.Now,
});
""";

    private const string DefaultsSample = """
// Per-prefix defaults: reference data rarely changes, keep it fresh for an hour.
client.SetDefaults(QueryKey.Of("countries"), new QueryDefaults
{
    StaleTime = TimeSpan.FromHours(1),
    RefetchOnMount = RefetchOnMount.Never,
});
""";
}
