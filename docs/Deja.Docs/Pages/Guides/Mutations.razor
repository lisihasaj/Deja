@code {
    private ApiRow[] Rows => De
        ?
        [
            new("MutationFunction", "Func<Task<T>>", null, "Gibt einen Wert zurück; die einfachste Form."),
            new("VoidMutationFunction", "Func<Task>", null, "Kein Rückgabewert; <code>Data</code> bleibt unberührt."),
            new("CancellableMutationFunction", "Func<CancellationToken, Task<T>>", null,
                "Gibt einen Wert zurück und beachtet das Lifetime-Token der Komponente — ein laufender Schreibvorgang wird aufgegeben, wenn die Komponente disposed wird."),
            new("CancellableVoidMutationFunction", "Func<CancellationToken, Task>", null, "Abbruchfähig, kein Rückgabewert."),
        ]
        :
        [
            new("MutationFunction", "Func<Task<T>>", null, "Returns a value; the simplest shape."),
            new("VoidMutationFunction", "Func<Task>", null, "No return value; <code>Data</code> is left untouched."),
            new("CancellableMutationFunction", "Func<CancellationToken, Task<T>>", null,
                "Returns a value and honours the component's lifetime token — an in-flight write is abandoned when the component is disposed."),
            new("CancellableVoidMutationFunction", "Func<CancellationToken, Task>", null, "Cancellation-aware, no return value."),
        ];

    private const string BasicSample = """
private readonly Mutation<Todo> _addTodo = new();

private Task Add() => _addTodo.Execute(
    token => Api.AddTodoAsync(_title, token),   // cancellation-aware shape
    p =>
    {
        p.OnSuccess = created => _title = "";
        p.OnError = e => _error = e.Message;
    });
""";

    private const string InvalidateSample = """
p.InvalidateKeys = [QueryKey.Of("todos")];
// invalidates ["todos"], ["todos","list",1], ["todos","detail",42], …
""";

    private const string ChainingSample = """
await _createOrder.Execute(() => Api.CreateOrderAsync(_draft), p => p.OnSuccessAsync = async order =>
{
    // The follow-up key comes from the result, which InvalidateKeys cannot express
    await _lines.Execute(QueryKey.Of("orders", order!.Id, "lines"),
        t => Api.GetOrderLinesAsync(order.Id, t),
        o => o.OnError = e => _error = e.Message);

    if (_lines.Data is { Count: 0 })
    {
        await _notify.Execute(() => Api.FlagEmptyOrderAsync(order.Id));
    }
});
""";
}
