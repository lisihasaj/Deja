<header class="site-header">
    @if (ShowSidebarToggle)
    {
        <button class="icon-button sidebar-toggle" @onclick="OnToggleSidebar"
                aria-label="@(Lang == Language.De ? "Navigation umschalten" : "Toggle navigation")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/></svg>
        </button>
    }

    <a class="site-logo" href="">
        <img src="favicon.svg" alt=""/>
        Deja
        <span class="version-tag">docs</span>
    </a>

    <div class="header-spacer"></div>

    <SearchBox/>

    <nav class="header-links" aria-label="@(Lang == Language.De ? "Externe Links" : "External links")">
        <LanguageToggle/>
        <ThemeToggle/>
        <a href="https://github.com/lisihasaj/Deja" target="_blank" rel="noopener"
           aria-label="@(Lang == Language.De ? "GitHub-Repository" : "GitHub repository")">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
        </a>
    </nav>
</header>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter] public bool ShowSidebarToggle { get; set; }
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
}
