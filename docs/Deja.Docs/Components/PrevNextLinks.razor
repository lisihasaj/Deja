@implements IDisposable
@inject NavigationManager Nav

@if (_prev is not null || _next is not null)
{
    <nav class="prev-next" aria-label="@(Lang == Language.De ? "Benachbarte Seiten" : "Adjacent pages")">
        @if (_prev is not null)
        {
            <a href="@LanguageService.PathFor(_prev.Href, Lang)" class="pn-prev">
                <span class="pn-label">@(Lang == Language.De ? "← Zurück" : "← Previous")</span>
                <span class="pn-title">@_prev.TitleFor(Lang)</span>
            </a>
        }
        @if (_next is not null)
        {
            <a href="@LanguageService.PathFor(_next.Href, Lang)" class="pn-next">
                <span class="pn-label">@(Lang == Language.De ? "Weiter →" : "Next →")</span>
                <span class="pn-title">@_next.TitleFor(Lang)</span>
            </a>
        }
    </nav>
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private NavItem? _prev;
    private NavItem? _next;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Update();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Update();
        StateHasChanged();
    }

    private void Update()
    {
        (_prev, _next) = DocsNav.Around(LanguageService.RouteOf(Nav.ToBaseRelativePath(Nav.Uri)));
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
