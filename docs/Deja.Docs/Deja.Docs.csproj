<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Deja.Docs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deja\Deja.csproj" />
  </ItemGroup>

  <!-- Demo pages show their own real source: the .razor files are embedded and read back at
       runtime, so the source tab can never drift from the running demo. -->
  <ItemGroup>
    <EmbeddedResource Include="Components\Demos\*.razor" />
  </ItemGroup>

</Project>
