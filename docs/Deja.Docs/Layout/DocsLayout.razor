@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime Js

<a class="skip-link" href="#docs-content">@(Lang == Language.De ? "Zum Inhalt springen" : "Skip to content")</a>

<SiteHeader ShowSidebarToggle="true" OnToggleSidebar="ToggleSidebar"/>

<div class="docs-shell">
    <Sidebar Open="_sidebarOpen"/>

    <main class="docs-main" id="docs-content">
        <article class="docs-article">
            @Body
            <PrevNextLinks/>
        </article>
    </main>

    <TableOfContents/>
</div>

<DemoControls/>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private bool _sidebarOpen;
    private bool _rebuildToc = true;
    private Language _tocLang;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    // Headings change with the language, so the ToC is rebuilt after a switch.
    protected override void OnParametersSet()
    {
        if (_tocLang != Lang)
        {
            _tocLang = Lang;
            _rebuildToc = true;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _sidebarOpen = false;
        _rebuildToc = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_rebuildToc)
        {
            _rebuildToc = false;
            await Js.InvokeVoidAsync("dejaDocs.buildToc");
        }
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
