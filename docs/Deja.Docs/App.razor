@implements IDisposable
@inject LanguageService Languages

<CascadingValue Value="Languages.Current">
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(DocsLayout)"/>
            <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
        </Found>
    </Router>
</CascadingValue>

@code {
    protected override void OnInitialized() => Languages.Changed += StateHasChanged;

    public void Dispose() => Languages.Changed -= StateHasChanged;
}
