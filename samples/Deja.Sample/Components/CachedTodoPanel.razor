@inherits DejaComponentBase
@inject FakeTodoApi Api

@* Instantiated twice by Pages/Cache.razor. Both panels use the same QueryKey, so they observe one
   cache entry: one in-flight fetch, one copy of the data, both updated together — while each
   Query<T> still notifies only its own component. *@

<section class="card">
    <header class="card-header">
        <h2>@Title</h2>
        <div class="badges">
            <span class="badge @(_todos.IsLoading ? "on" : "")">IsLoading</span>
            <span class="badge @(_todos.IsReFetching ? "on" : "")">IsReFetching</span>
            <span class="badge @(_todos.IsCachedData ? "on" : "")">IsCachedData</span>
            <span class="badge @(_todos.IsError ? "on err" : "")">IsError</span>
            <span class="badge on neutral">Renders: @_renderCount</span>
        </div>
    </header>

    @if (_todos.Data is { } todos)
    {
        @* Data stays on screen during background refetches — the IsReFetching badge is the only flash. *@
        <ul class="todo-list">
            @foreach (var todo in todos)
            {
                <li>@todo.Title</li>
            }
        </ul>
    }
    else if (_todos.IsError)
    {
        <p class="error" role="alert">@_todos.ErrorMessage</p>
    }
    else
    {
        <p class="muted">Loading todos…</p>
    }

    <div class="actions">
        <button @onclick="LoadTodos" disabled="@_todos.IsLoading">Refetch @Title</button>
    </div>
</section>

@code {
    /// <summary>Distinguishes the two panels in the UI.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    private readonly Query<IReadOnlyList<Todo>> _todos = new();
    private int _renderCount;

    protected override async Task OnInitializedAsync() => await LoadTodos();

    protected override void OnAfterRender(bool firstRender) => _renderCount++;

    // Shared QueryKey: cached data renders instantly on mount, then one background refetch —
    // deduplicated across both panels — revalidates it and updates both. No cancellation wiring
    // either: the base hands this query the component's lifetime token.
    private Task LoadTodos() =>
        _todos.Execute("todos", Api.GetTodosAsync, p => p.OnError = _ => { });
}
