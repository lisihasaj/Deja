@inherits DejaComponentBase
@inject FakeTodoApi Api

@* The correct half of Pages/Lifecycle.razor: the OnInitialized override calls
   base.OnInitialized() first, so _todos is attached before the fetch starts. *@

<section class="card">
    <header class="card-header">
        <h2>base.OnInitialized() called</h2>
        <div class="badges">
            <span class="badge @(_todos.IsLoading ? "on" : "")">IsLoading</span>
            <span class="badge @(_todos.IsError ? "on err" : "")">IsError</span>
            <span class="badge on neutral">Renders: @_renderCount</span>
        </div>
    </header>

    @if (_todos.IsLoading)
    {
        <p class="muted">Loading todos…</p>
    }
    else if (_todos.IsError)
    {
        <p class="error" role="alert">@_todos.ErrorMessage</p>
    }
    else
    {
        <ul class="todo-list">
            @foreach (var todo in _todos.Data ?? [])
            {
                <li>@todo.Title</li>
            }
        </ul>
    }

    <p class="hint">
        The list appeared on its own about a second in: the base call attached
        <code>_todos</code>, so the fetch completing re-rendered this panel.
    </p>
</section>

@code {
    private readonly Query<IReadOnlyList<Todo>> _todos = new();
    private int _renderCount;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _ = LoadTodos();
    }

    protected override void OnAfterRender(bool firstRender) => _renderCount++;

    private Task LoadTodos() => _todos.Execute(new QueryParameters<IReadOnlyList<Todo>>
    {
        QueryFunction = Api.GetTodosAsync,
        OnError = _ => { },
    });
}
