@inherits DejaComponentBase
@inject FakeTodoApi Api

@* The deliberately broken half of Pages/Lifecycle.razor: the OnInitialized override skips
   base.OnInitialized(), so _todos is never attached. The fetch still runs and completes,
   but nothing re-renders this panel — and the base reports the skipped call in the console. *@

<section class="card">
    <header class="card-header">
        <h2>base.OnInitialized() skipped</h2>
        <div class="badges">
            <span class="badge @(_todos.IsLoading ? "on" : "")">IsLoading</span>
            <span class="badge @(_todos.IsError ? "on err" : "")">IsError</span>
            <span class="badge on neutral">Renders: @_renderCount</span>
        </div>
    </header>

    @if (_todos.IsLoading)
    {
        <p class="muted">Loading todos…</p>
    }
    else if (_todos.IsError)
    {
        <p class="error" role="alert">@_todos.ErrorMessage</p>
    }
    else
    {
        <ul class="todo-list">
            @foreach (var todo in _todos.Data ?? [])
            {
                <li>@todo.Title</li>
            }
        </ul>
    }

    <div class="actions">
        <button class="secondary" @onclick="ForceRender">Force render</button>
    </div>
    <p class="hint">
        Stuck on “Loading todos…”? The data actually arrived about a second in, but with
        <code>_todos</code> unattached its state change re-rendered nothing. “Force render”
        (a no-op handler — any UI event re-renders in Blazor) reveals the data was there all
        along, and the browser console holds the <code>[Deja]</code> error naming this component.
    </p>
</section>

@code {
    private readonly Query<IReadOnlyList<Todo>> _todos = new();
    private int _renderCount;

    protected override void OnInitialized()
    {
        // Deliberately missing: base.OnInitialized();
        _ = LoadTodos();
    }

    protected override void OnAfterRender(bool firstRender) => _renderCount++;

    private void ForceRender()
    {
    }

    private Task LoadTodos() => _todos.Execute(new QueryParameters<IReadOnlyList<Todo>>
    {
        QueryFunction = Api.GetTodosAsync,
        OnError = _ => { },
    });
}
