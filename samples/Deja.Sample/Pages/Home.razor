@page "/"
@implements IDisposable
@inject FakeTodoApi Api

<PageTitle>Deja — React Query-style data fetching for Blazor</PageTitle>

<h1>Deja</h1>
<p class="lead">
    React Query-style data fetching, mutation and caching primitives for Blazor.
    The list below is served by a fake API with ~1s of latency so every lifecycle
    state is visible.
</p>

<section class="card">
    <header class="card-header">
        <h2>Query</h2>
        <div class="badges">
            <span class="badge @(_todos.InitialLoading ? "on" : "")">InitialLoading</span>
            <span class="badge @(_todos.IsLoading ? "on" : "")">IsLoading</span>
            <span class="badge @(_todos.IsReFetching ? "on" : "")">IsReFetching</span>
            <span class="badge @(_todos.IsError ? "on err" : "")">IsError</span>
            <span class="badge on neutral">ReFetchCount: @_todos.ReFetchCount</span>
        </div>
    </header>

    @if (_todos.InitialLoading)
    {
        <p class="muted">Loading todos…</p>
    }
    else if (_todos.IsError)
    {
        <p class="error" role="alert">@_todos.ErrorMessage</p>
    }
    else
    {
        <ul class="todo-list">
            @foreach (var todo in _todos.Data ?? [])
            {
                <li>@todo.Title</li>
            }
        </ul>
    }

    <div class="actions">
        <button @onclick="LoadTodos" disabled="@_todos.IsLoading">Refetch</button>
        <button class="secondary" @onclick="FailNextFetch" disabled="@_todos.IsLoading">Fail next fetch</button>
    </div>
    <p class="hint">
        “Refetch” keeps the current data on screen and only raises <code>IsReFetching</code> —
        no loading flash. “Fail next fetch” shows the error path; a successful refetch clears it.
    </p>
</section>

<section class="card">
    <header class="card-header">
        <h2>Mutation</h2>
        <div class="badges">
            <span class="badge @(_addTodo.IsLoading ? "on" : "")">IsLoading</span>
            <span class="badge @(_addTodo.IsError ? "on err" : "")">IsError</span>
        </div>
    </header>

    <div class="actions">
        <input placeholder="What needs doing?" @bind="_newTitle" @bind:event="oninput" />
        <button @onclick="AddTodo" disabled="@_addTodo.IsLoading">
            @(_addTodo.IsLoading ? "Adding…" : "Add todo")
        </button>
    </div>

    @if (_mutationError is not null)
    {
        <p class="error" role="alert">@_mutationError</p>
    }

    <p class="hint">
        On success the mutation refetches the query above. Submitting an empty title raises a
        <code>DisplayUserException</code>, routed to the <code>OnDisplayUserError</code> callback.
    </p>
</section>

@code {

    private readonly Query<IReadOnlyList<Todo>> _todos = new();
    private readonly Mutation<Todo> _addTodo = new();
    private string _newTitle = string.Empty;
    private string? _mutationError;

    protected override async Task OnInitializedAsync()
    {
        _todos.PropertyChanged += OnStateChanged;
        _addTodo.PropertyChanged += OnStateChanged;

        await LoadTodos();
    }

    private void OnStateChanged(object? sender, PropertyChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    private Task LoadTodos() => _todos.Execute(new QueryParameters<IReadOnlyList<Todo>>
    {
        QueryKey = "todos",
        QueryFunctionWithToken = Api.GetTodosAsync,
        // The error is rendered inline from IsError/ErrorMessage; an empty handler marks it
        // handled so Execute doesn't rethrow into the component lifecycle.
        OnError = _ => { },
    });

    private void FailNextFetch()
    {
        Api.FailNextFetch = true;
        _ = LoadTodos();
    }

    private async Task AddTodo()
    {
        _mutationError = null;

        try
        {
            await _addTodo.Execute(new MutationParameters<Todo>
            {
                MutationFunction = () => Api.AddTodoAsync(_newTitle),
                OnDisplayUserError = e => _mutationError = e.DisplayMessage,
                OnError = e => _mutationError ??= e.Message,
                OnSuccessAsync = async _ =>
                {
                    _newTitle = string.Empty;
                    await LoadTodos();
                },
            });
        }
        catch (InvalidOperationException)
        {
            // Mutation.Execute rethrows after the callbacks ran; the error is already
            // surfaced via _mutationError.
        }
    }

    public void Dispose()
    {
        _todos.PropertyChanged -= OnStateChanged;
        _addTodo.PropertyChanged -= OnStateChanged;
        _todos.Dispose();
    }

}
