@page "/cache"
@inherits DejaComponentBase
@inject FakeTodoApi Api

<PageTitle>Deja — shared query cache</PageTitle>

<h1>Cache</h1>
<p class="lead">
    Both panels use the QueryKey <code>"todos"</code>, so they share one cache entry: one fetch,
    one copy of the data, both updated together — yet each <code>Query&lt;T&gt;</code> still
    notifies only its own component. Navigate to another page and back: the list renders instantly
    from cache (<code>IsCachedData</code>) while a background refetch revalidates it. The home
    page's query uses the same key, so it shares this entry too.
</p>

<section class="card">
    <header class="card-header">
        <h2>Add a todo</h2>
        <div class="badges">
            <span class="badge @(_addTodo.IsLoading ? "on" : "")">IsLoading</span>
            <span class="badge @(_addTodo.IsError ? "on err" : "")">IsError</span>
        </div>
    </header>

    <div class="actions">
        <input placeholder="What needs doing?" @bind="_newTitle" @bind:event="oninput" />
        <button @onclick="AddTodo" disabled="@_addTodo.IsLoading">
            @(_addTodo.IsLoading ? "Adding…" : "Add todo")
        </button>
    </div>

    @if (_mutationError is not null)
    {
        <p class="error" role="alert">@_mutationError</p>
    }

    <p class="hint">
        The mutation lists <code>InvalidateKeys = [QueryKey.Of("todos")]</code>: on success the
        key is invalidated and <em>every</em> mounted query under it refetches in the background —
        both panels below, in one call, with no manual wiring between components.
    </p>
</section>

<CachedTodoPanel Title="Left" />
<CachedTodoPanel Title="Right" />

@code {

    private readonly Mutation<Todo> _addTodo = new();
    private string _newTitle = string.Empty;
    private string? _mutationError;

    private async Task AddTodo()
    {
        _mutationError = null;

        // The token is this component's, handed over automatically, so navigating away mid-write
        // abandons it without the page owning a CancellationTokenSource.
        await _addTodo.Execute(token => Api.AddTodoAsync(_newTitle, token), p =>
        {
            // The error callbacks mark the failure handled, so Execute doesn't rethrow into the
            // component lifecycle — no try/catch at the call site.
            p.OnDisplayUserError = e => _mutationError = e.DisplayMessage;
            p.OnError = e => _mutationError ??= e.Message;
            p.OnSuccess = _ => _newTitle = string.Empty;
            // Unlike a manual refetch, this updates every component showing todos, not just this one.
            p.InvalidateKeys = [QueryKey.Of("todos")];
        });
    }

}
