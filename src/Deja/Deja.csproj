<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Deja</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package identity -->
  <PropertyGroup>
    <PackageId>Deja</PackageId>
    <Title>Deja</Title>
    <Authors>Lisjan Hasaj</Authors>
    <Description>Data fetching, mutation and caching primitives for Blazor (WebAssembly and Server): bindable loading/error/refetch state, in-flight request deduplication, supersede-and-cancel of stale executions, and cancellation-aware fetches. Dependency-free.</Description>
    <PackageTags>blazor;query;data-fetching;fetch;cache;caching;mutation;async;state;webassembly;wasm;blazor-server</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://lisihasaj.github.io/Deja/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lisihasaj/Deja</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>deja.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/lisihasaj/Deja/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Build quality, supply chain and debugging experience -->
  <PropertyGroup>
    <!-- SourceLink (built into the .NET 8+ SDK) -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Symbol package published alongside the nupkg -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Validate the package on pack (baseline version added after first stable release) -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Version is derived from git tags (v*) by MinVer -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- Pre-release versions before the first tag start at 0.1.0-alpha.x -->
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Needed by DejaComponentBase (ComponentBase, [Parameter], [Inject]). IDejaObservable,
       DejaObservable, Query<T> and Mutation<T> stay pure BCL, so splitting the component base
       into a separate Deja.Components package later remains source-compatible.

       A PackageReference rather than <FrameworkReference Include="Microsoft.AspNetCore.App" />:
       the framework reference flows transitively to consumers and demands a *runtime* pack, which
       does not exist for the browser-wasm RID — every Blazor WebAssembly app referencing Deja
       would fail to build with NETSDK1082. This package carries just the component abstractions
       and resolves on both WASM and Server. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.0" />
    <!-- Needed by AddDeja. Already in the transitive closure of
         Microsoft.AspNetCore.Components, so it adds no new dependency in practice; referenced
         explicitly to keep the intent clear. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Deja.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="deja.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
