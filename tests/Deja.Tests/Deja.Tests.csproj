<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (oldest supported target) and net10.0 (newest). CI runs both; locally run
         `dotnet test -f net10.0` if only the .NET 10 runtime is installed. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- CA1707: underscores are the standard naming convention for test methods. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- bUnit 2.x targets net10.0 only, so the component-rendering tests (DejaComponentBaseTests)
       compile on the net10.0 leg alone. The net8.0 leg still covers Query, Mutation and
       DejaObservable, which are pure BCL. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="bunit" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Deja\Deja.csproj" />
  </ItemGroup>

</Project>
